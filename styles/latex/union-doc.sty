\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{union-doc}[2026/03/31 Union document styling presets]

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{geometry}
\RequirePackage{xcolor}
\RequirePackage{hyperref}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{tcolorbox}
\RequirePackage{ifthen}
\RequirePackage{helvet}
\RequirePackage{inconsolata}

\geometry{letterpaper, margin=1in}
\renewcommand{\familydefault}{\sfdefault}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.65em}

\definecolor{UnionBlack}{HTML}{000000}
\definecolor{UnionWhite}{HTML}{FFFFFF}
\definecolor{UnionRed}{HTML}{D6001C}

\color{UnionBlack}
\hypersetup{
  colorlinks=true,
  linkcolor=UnionRed,
  urlcolor=UnionRed,
  citecolor=UnionRed,
  pdfborder={0 0 0},
}

\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

\newcommand{\UnionPresetEditorial}{%
  \titleformat{\section}{\Large\bfseries\color{UnionRed}}{}{0pt}{}%
  \titleformat{\subsection}{\large\bfseries\color{UnionBlack}}{}{0pt}{}%
}

\newcommand{\UnionPresetSignal}{%
  \titleformat{\section}{\Large\bfseries\color{UnionRed}}{}{0pt}{}%
  \titleformat{\subsection}{\large\bfseries\color{UnionRed}}{}{0pt}{}%
}

\newcommand{\UnionPresetBrief}{%
  \titleformat{\section}{\Large\bfseries\color{UnionBlack}}{}{0pt}{}%
  \titleformat{\subsection}{\large\bfseries\color{UnionRed}}{}{0pt}{}%
}

\newcommand{\UnionUsePreset}[1]{%
  \ifthenelse{\equal{#1}{signal}}{%
    \UnionPresetSignal
  }{%
    \ifthenelse{\equal{#1}{brief}}{%
      \UnionPresetBrief
    }{%
      \UnionPresetEditorial
    }%
  }%
}

\newtcolorbox{unionpanel}{
  colback=UnionWhite,
  colframe=UnionRed,
  boxrule=0.8pt,
  arc=2mm,
  left=4mm,
  right=4mm,
  top=3mm,
  bottom=3mm,
}

\newcommand{\UnionTitleBlock}[3]{%
  \begin{center}
    \begin{tcolorbox}[colback=UnionWhite,colframe=UnionRed,boxrule=0.8pt,arc=2mm,width=0.92\textwidth]
      \centering
      {\fontsize{22}{26}\selectfont\bfseries\color{UnionRed} #1\par}
      \vspace{0.35em}
      {\normalsize\color{UnionBlack} #2\par}
      \vspace{0.2em}
      {\small\color{UnionBlack} #3\par}
    \end{tcolorbox}
  \end{center}
}
